{
  "name": "agent-autonomous",
  "version": "0.1.0",
  "private": true,
  "description": "A reusable kit for running coding agents autonomously over long projects: a validated work queue, a lane guard, documentation freshness stamps, command receipts, and compaction recovery hooks.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "autonomous-install": "bin/autonomous-install.mjs",
    "autonomous-uninstall": "bin/autonomous-uninstall.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:autonomous": "node bin/autonomous-install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
